<?xml version="1.0" encoding="utf-8"?>
<!-- Compact branded badge for the toolbar: gradient circle + the
     same "A" mark as the launcher icon, at a size that reads cleanly
     at ~28-32dp instead of being a scaled-down 108dp adaptive icon. -->
